// Expected rejection: a sending operation is consumed by the first invocation.
import IO_Events

func repeatOperation(
    on actor: Event.Actor,
    borrowing descriptor: borrowing Kernel.Descriptor,
    operation: sending (borrowing Kernel.Descriptor) -> Int
) async throws(Event.Operation.Error<Never>) {
    _ = try await actor.run(borrowing: descriptor, interest: .read, operation: operation)
    _ = try await actor.run(borrowing: descriptor, interest: .read, operation: operation)
}
