// Expected rejection: the operation result cannot capture the borrowed descriptor.
import IO_Events

func escape(
    on actor: Event.Actor,
    borrowing descriptor: borrowing Kernel.Descriptor
) async throws(Event.Failure) -> (
    IO<Never>.Operation<() -> Void, Event.Wait.Error<Never>>,
    IO<Never>.Completion
) {
    try await actor.enlist(borrowing: descriptor, interest: .read) { descriptor in
        { _ = descriptor }
    }
}
