import IO_Events

struct Output: ~Copyable {
    let value: Int
}

func enlist(
    on actor: Event.Actor,
    borrowing descriptor: borrowing Kernel.Descriptor
) throws(Event.Failure) -> (
    IO<Never>.Operation<Output, Event.Wait.Error<Never>>,
    IO<Never>.Completion
) {
    try actor.enlist(borrowing: descriptor, interest: .read) { _ in
        Output(value: 1)
    }
}
